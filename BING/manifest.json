{
  "manifest_version": 3,
  "name": "Auto Typer (Buyer's Edition)",
  "version": "1.1",
  "description": "Fact phrase typer with AI-generated prompts.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel"],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://login.live.com/*",
    "https://login.microsoftonline.com/*",
    "https://account.microsoft.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png"
    },
    "default_title": "Click to open Auto Typer"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.js"],
      "matches": ["<all_urls>"]
    }
  ]
}